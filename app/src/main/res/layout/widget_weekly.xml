<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/weekly_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <TextView
            android:id="@+id/weekly_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/weekly_title"
            android:textColor="#EEF2EF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1" />

        <TextView
            android:id="@+id/weekly_used"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#EEF2EF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/weekly_pace"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#8E9993"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/weekly_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8E9993"
            android:textSize="12sp"
            android:maxLines="1" />
    </LinearLayout>

    <ImageView
        android:id="@+id/weekly_chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/weekly_chart_desc" />

    <TextView
        android:id="@+id/weekly_legend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#8E9993"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- RemoteViews cannot inflate a bare View; a FrameLayout draws the divider. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="#1FFFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/weekly_workers"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#8E9993"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/weekly_status_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dot"
            android:textSize="9sp"
            android:paddingStart="8dp"
            android:paddingEnd="4dp" />

        <TextView
            android:id="@+id/weekly_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8E9993"
            android:textSize="11sp"
            android:maxLines="1"
            android:text="@string/status_placeholder" />
    </LinearLayout>
</LinearLayout>
