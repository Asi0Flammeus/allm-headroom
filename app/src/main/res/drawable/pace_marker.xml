<?xml version="1.0" encoding="utf-8"?>
<!-- Thin high-contrast tick for the linear-pace marker: readable over the
     green/amber/red bar fill and the dark track behind it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#F3F4F6" />
    <stroke android:width="0.5dp" android:color="#00000080" />
    <corners android:radius="1dp" />
</shape>
