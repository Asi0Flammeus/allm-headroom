<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_app"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <receiver
            android:name=".UsageWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="cat.alysis.foldusage.REFRESH" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/usage_widget_info" />
        </receiver>

        <!-- The larger Anthropic weekly view: curve vs even pace, per-day usage types, workers left. -->
        <receiver
            android:name=".WeeklyWidgetProvider"
            android:exported="false"
            android:label="@string/weekly_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weekly_widget_info" />
        </receiver>

        <activity
            android:name=".ConfigActivity"
            android:exported="true"
            android:theme="@style/Settings"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- NoActionBar: the screen draws its own title, and at targetSdk 35+ the
             framework action bar sat over the first lines of content. -->
        <activity
            android:name=".HeadroomActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar" />

        <!-- Full-screen weekly chart, opened from the weekly widget. Its own task, out of
             recents: back or Close returns to the home screen, not to the settings. -->
        <activity
            android:name=".WeeklyChartActivity"
            android:exported="false"
            android:taskAffinity="cat.alysis.foldusage.weeklychart"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
    </application>
</manifest>
